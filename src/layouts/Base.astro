---
interface Props {
  title: string;
  description: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
}
const { title, description, jsonLd, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ga = import.meta.env.PUBLIC_GA4_ID;
const fullTitle = title === 'Canned Latte' ? 'Canned Latte: every latte in a can, ranked' : `${title} · Canned Latte`;
---
<!doctype html>
<html lang="en" style="color-scheme: light">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex" />}
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonical} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="sitemap" href="/sitemap-index.xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600;9..40,700;9..40,800&family=Geist+Mono:wght@400;500;600&display=swap" />
  {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  {ga && (
    <>
      <script async src={`https://www.googletagmanager.com/gtag/js?id=${ga}`}></script>
      <script is:inline define:vars={{ ga }}>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', ga);
      </script>
    </>
  )}
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <header class="site">
    <a class="brand" href="/" aria-label="Canned Latte home">
      <svg width="26" height="26" viewBox="0 0 26 26" aria-hidden="true"><rect x="7" y="2" width="12" height="22" rx="3.5" fill="var(--primary)"/><rect x="7" y="2" width="12" height="5" rx="2.5" fill="#fff" opacity=".85"/><rect x="9.5" y="11" width="7" height="8" rx="1.5" fill="#fff" opacity=".9"/></svg>
      <span>canned<b>latte</b></span>
    </a>
    <nav aria-label="Main">
      <a href="/best/most-caffeine">Rankings</a>
      <a href="/brands">Brands</a>
      <a href="/new">New</a>
      <a href="/about">About</a>
      <a class="icon" href="/table" aria-label="Full table" title="Full sortable table">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
      </a>
    </nav>
  </header>
  <main id="main"><slot /></main>
  <footer class="site">
    <p>Specs come from product labels, brand sites and press releases, and are date-stamped on every page. Caffeine varies by batch; treat figures as typical, not exact.</p>
    <p><a href="/about">About</a> · <a href="/disclosure">Affiliate disclosure</a> · <a href="/new">New launches</a> · <a href="/shop">Stickers &amp; shirts</a> · <a href="/table">Full table</a></p>
    <p>© {new Date().getFullYear()} cannedlatte.com</p>
  </footer>
</body>
</html>

<style is:global>
  :root{
    --background:#fffdfa; --card:#fffdfa; --foreground:#282624;
    --muted:#f6f3ef; --muted-foreground:#67625d; --border:#e6e0da;
    --primary:#e57255; --primary-foreground:#fff; --primary-soft:#fbe9e3;
    --live:#009f31; --warn:#b26a0b;
    --podium-1-bg:#e7ebf6; --podium-1:#3060e8;
    --podium-2-bg:#e3f3ea; --podium-2:#1f8a5a;
    --podium-3-bg:#efece8; --podium-3:#77726d;
    --radius:.875rem;
    --sans:"DM Sans","DM Sans Fallback",system-ui,-apple-system,"Segoe UI",sans-serif;
    --mono:"Geist Mono","Geist Mono Fallback",ui-monospace,Menlo,Consolas,monospace;
  }
  *{box-sizing:border-box}
  html{-webkit-font-smoothing:antialiased;text-rendering:optimizeLegibility}
  body{margin:0;background:var(--background);color:var(--foreground);font-family:var(--sans);font-size:16px;line-height:1.5}
  a{color:inherit;text-decoration:none}
  a:hover{color:var(--primary)}
  p a,.prose a{color:var(--primary);text-decoration:underline;text-underline-offset:3px;text-decoration-thickness:1px}
  a:focus-visible,button:focus-visible,select:focus-visible,input:focus-visible{outline:2px solid var(--primary);outline-offset:3px;border-radius:6px}
  .skip{position:absolute;left:-999px;top:8px;background:var(--primary);color:#fff;padding:8px 12px;border-radius:999px}
  .skip:focus{left:8px}

  header.site{display:flex;align-items:center;justify-content:space-between;gap:16px;max-width:720px;margin:0 auto;padding:18px 20px}
  .brand{display:flex;align-items:center;gap:8px;font-size:22px;font-weight:500;letter-spacing:-.01em}
  .brand b{font-weight:800;color:var(--primary)}
  header.site nav{display:flex;align-items:center;gap:4px 16px;font-weight:500;font-size:15px}
  header.site nav a:not(.icon){color:var(--foreground)}
  header.site nav a:not(.icon):hover{color:var(--primary)}
  .icon{display:inline-flex;align-items:center;justify-content:center;width:36px;height:36px;border-radius:999px;border:0;background:transparent;color:var(--foreground);cursor:pointer}
  .icon:hover{background:var(--muted)}

  main{max-width:720px;margin:0 auto;padding:12px 20px 64px}
  footer.site{max-width:720px;margin:0 auto;padding:24px 20px 48px;border-top:1px solid var(--border);font-size:13.5px;color:var(--muted-foreground)}
  footer.site p{margin:0 0 8px}
  footer.site a{color:var(--muted-foreground);text-decoration:underline;text-underline-offset:3px}

  h1{font-size:clamp(28px,5vw,38px);font-weight:700;line-height:1.1;letter-spacing:-.025em;margin:0 0 10px;text-wrap:balance}
  h1 .hl{color:var(--primary)}
  h2{font-size:20px;font-weight:700;letter-spacing:-.015em;margin:32px 0 12px;text-wrap:balance}
  h3{font-size:16px;font-weight:600;margin:0 0 4px}
  p{margin:0 0 12px;max-width:62ch}
  .lede{font-size:17px;color:var(--muted-foreground)}
  .center{text-align:center}
  .center p{margin-left:auto;margin-right:auto}
  .eyebrow{font-family:var(--mono);font-size:12px;letter-spacing:.02em;color:var(--muted-foreground);margin:0 0 10px}
  .mono{font-family:var(--mono)}
  .num{font-family:var(--mono);font-variant-numeric:tabular-nums}
  .accent{color:var(--primary);font-weight:700}

  /* status pill: "● 18 cans · updated Aug 31" */
  .status{display:inline-flex;align-items:center;gap:8px;background:var(--muted);border-radius:999px;padding:6px 14px;font-size:13.5px;color:var(--muted-foreground);margin:8px auto 18px}
  .status .dot{width:8px;height:8px;border-radius:50%;background:var(--live);display:inline-block}
  .status b{color:var(--foreground);font-weight:600}

  /* tabs with coral underline */
  .tabs{display:flex;justify-content:center;gap:4px;border-bottom:1px solid var(--border);margin:0 0 20px;overflow-x:auto}
  .tabs button,.tabs a{background:none;border:0;border-bottom:2px solid transparent;padding:10px 14px;font:inherit;font-weight:500;font-size:15px;color:var(--muted-foreground);cursor:pointer;white-space:nowrap;display:inline-flex;align-items:center;gap:6px}
  .tabs [aria-selected="true"],.tabs .active{color:var(--foreground);border-bottom-color:var(--primary)}
  .tabs .dot{width:7px;height:7px;border-radius:50%;background:var(--primary);display:inline-block}

  /* pill filters */
  .pills{display:flex;gap:8px;overflow-x:auto;padding:2px 0 10px;margin:0 0 8px;scrollbar-width:none}
  .pills::-webkit-scrollbar{display:none}
  .pill{display:inline-flex;align-items:center;gap:6px;border-radius:999px;padding:7px 14px;font-size:13px;font-weight:700;background:var(--background);color:var(--foreground);border:1px solid var(--border);cursor:pointer;white-space:nowrap;font-family:var(--sans)}
  .pill:hover{background:var(--muted)}
  .pill[aria-pressed="true"],.pill.on{background:var(--primary);color:#fff;border-color:var(--primary)}
  .tag{display:inline-flex;align-items:center;border-radius:999px;padding:2px 9px;font-size:11.5px;font-weight:600;background:var(--muted);color:var(--muted-foreground);white-space:nowrap}
  .tag.warn{background:transparent;border:1px solid var(--warn);color:var(--warn)}
  .tag.live{background:transparent;border:1px solid var(--live);color:var(--live)}

  /* buttons */
  .btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;height:44px;padding:0 20px;border-radius:999px;background:var(--primary);color:#fff;font-weight:700;font-size:14px;border:0;cursor:pointer;font-family:var(--sans)}
  .btn:hover{filter:brightness(.95);color:#fff}
  .btn.secondary{background:var(--muted);color:var(--foreground)}
  .btn.secondary:hover{background:var(--border)}
  .btn.block{width:100%}
  .buy{display:flex;flex-wrap:wrap;gap:10px;margin:16px 0}

  /* search / inputs */
  .search{display:flex;align-items:center;gap:10px;border:1px solid var(--border);border-radius:var(--radius);background:var(--card);padding:0 16px;height:52px;margin:0 0 12px}
  .search svg{color:var(--muted-foreground);flex:none}
  .search input{flex:1;border:0;background:transparent;font:inherit;font-size:16px;color:var(--foreground);min-width:0}
  .search input::placeholder{color:var(--muted-foreground)}
  .search input:focus{outline:none}
  select.field{font:inherit;font-size:15px;height:52px;padding:0 16px;border:1px solid var(--border);border-radius:var(--radius);background:var(--card);color:var(--foreground);width:100%;margin:0 0 12px}

  /* ranked cards */
  .feed{display:flex;flex-direction:column;gap:12px;margin:8px 0 24px}
  .rank{position:relative;display:grid;grid-template-columns:auto 1fr;gap:14px;background:var(--card);border:1px solid var(--border);border-radius:var(--radius);padding:16px;transition:transform .12s,border-color .12s}
  .rank[hidden]{display:none}
  .rank:hover{border-color:var(--primary);transform:translateY(-1px);color:inherit}
  .rank[data-rank="1"]{background:var(--podium-1-bg);border:2px solid var(--podium-1)}
  .rank[data-rank="2"]{background:var(--podium-2-bg);border-color:var(--podium-2)}
  .rank[data-rank="3"]{background:var(--podium-3-bg);border-color:var(--podium-3)}
  .rank .pos{position:absolute;top:10px;left:14px;font-size:12px;font-weight:700;color:var(--muted-foreground)}
  .rank[data-rank="1"] .pos{color:var(--podium-1)}
  .rank[data-rank="2"] .pos{color:var(--podium-2)}
  .rank[data-rank="3"] .pos{color:var(--podium-3)}
  .rank .avatar{width:52px;height:52px;border-radius:14px;background:var(--foreground);color:var(--background);display:flex;align-items:center;justify-content:center;font-weight:800;font-size:15px;letter-spacing:-.02em;margin-top:18px;overflow:hidden;flex:none}
  .rank .avatar img{width:100%;height:100%;object-fit:cover}
  .rank .body{min-width:0;padding-top:18px}
  .rank .top{display:flex;justify-content:space-between;align-items:baseline;gap:12px}
  .rank .name{font-weight:700;font-size:16px;letter-spacing:-.01em;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .rank .stat{font-family:var(--mono);font-weight:600;font-size:16px;color:var(--primary);white-space:nowrap}
  .rank .desc{font-size:14px;color:var(--muted-foreground);margin:4px 0 8px;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
  .rank .meta{display:flex;flex-wrap:wrap;gap:6px 10px;font-size:12.5px;color:var(--muted-foreground);align-items:center}
  .rank .meta b{color:var(--foreground);font-weight:600}
  .rank .meta .sep::before{content:"·"}

  /* stats row */
  .stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(120px,1fr));gap:10px;margin:18px 0}
  .stat-card{background:var(--muted);border-radius:var(--radius);padding:14px 16px}
  .stat-card .n{font-family:var(--mono);font-weight:600;font-size:22px;letter-spacing:-.02em;line-height:1.1;font-variant-numeric:tabular-nums}
  .stat-card .l{font-size:12.5px;color:var(--muted-foreground);margin-top:6px}

  /* cards & grid */
  .card{background:var(--card);border:1px solid var(--border);border-radius:var(--radius);padding:16px 18px}
  .card p{font-size:14.5px;color:var(--muted-foreground)}
  a.card:hover{border-color:var(--primary);color:inherit}
  .grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(210px,1fr));gap:12px;margin:14px 0}
  .disclosure{font-size:13px;color:var(--muted-foreground);background:var(--muted);border-radius:var(--radius);padding:10px 14px;margin:16px 0}
  .meta{font-family:var(--mono);font-size:12.5px;color:var(--muted-foreground)}
  .row-link{display:flex;justify-content:space-between;align-items:center;margin:28px 0 8px}
  .row-link a.more{font-size:13.5px;color:var(--primary);font-weight:600}

  /* tables (full table page, brand pages, spec sheets) */
  .tablewrap{overflow-x:auto;border:1px solid var(--border);border-radius:var(--radius);background:var(--card);margin:16px 0}
  table{border-collapse:collapse;width:100%;font-size:14px;font-variant-numeric:tabular-nums}
  th,td{padding:11px 12px;text-align:left;vertical-align:top;border-bottom:1px solid var(--border)}
  th{font-size:12px;font-weight:600;color:var(--muted-foreground);background:var(--muted);white-space:nowrap}
  th[data-sort]{cursor:pointer;user-select:none}
  th[data-sort]:hover{color:var(--primary)}
  th[aria-sort="ascending"]::after{content:" ↑";color:var(--primary)}
  th[aria-sort="descending"]::after{content:" ↓";color:var(--primary)}
  tr:last-child td{border-bottom:none}
  td.num{font-family:var(--mono);font-size:13px;white-space:nowrap}
  td a{font-weight:600}
  ul{padding-left:20px}
  li{margin:0 0 6px}
  img.hero{max-width:100%;border-radius:var(--radius);border:1px solid var(--border)}
  @media (max-width:560px){
    header.site{flex-wrap:wrap}
    header.site nav{gap:4px 12px;font-size:14px}
    .rank .name{white-space:normal}
  }
  @media (prefers-reduced-motion:reduce){.rank{transition:none}}
</style>
