---
interface Props {
  title: string;
  description: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
}
const { title, description, jsonLd, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ga = import.meta.env.PUBLIC_GA4_ID;
const fullTitle = title === 'Canned Latte' ? 'Canned Latte: every latte in a can, compared' : `${title} · Canned Latte`;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex" />}
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonical} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="sitemap" href="/sitemap-index.xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,700&family=Literata:opsz,wght@7..72,400;7..72,600&family=IBM+Plex+Mono:wght@400;500&display=swap" />
  {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  {ga && (
    <>
      <script async src={`https://www.googletagmanager.com/gtag/js?id=${ga}`}></script>
      <script is:inline define:vars={{ ga }}>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', ga);
      </script>
    </>
  )}
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <header class="site">
    <a class="brand" href="/">Canned<span>Latte</span></a>
    <nav aria-label="Main">
      <a href="/best/least-sugar">Least sugar</a>
      <a href="/best/most-caffeine">Most caffeine</a>
      <a href="/best/oat-milk">Oat milk</a>
      <a href="/brands">Brands</a>
      <a href="/new">New</a>
      <a href="/shop">Shop</a>
    </nav>
  </header>
  <main id="main"><slot /></main>
  <footer class="site">
    <p>Specs come from product labels, brand sites and press releases, and are date-stamped on every page. Caffeine varies by batch; treat figures as typical, not exact.</p>
    <p><a href="/about">About</a> · <a href="/disclosure">Affiliate disclosure</a> · <a href="/new">New launches</a> · <a href="/shop">Stickers &amp; shirts</a></p>
    <p>© {new Date().getFullYear()} cannedlatte.com</p>
  </footer>
</body>
</html>

<style is:global>
  :root{
    --ground:#F4F2ED; --surface:#FFFFFF; --surface-2:#ECE8E0;
    --ink:#1E1A16; --ink-2:#4A433C; --muted:#7A7169; --line:#D9D3C8;
    --accent:#1F6F78; --accent-ink:#FFFFFF; --accent-soft:#DDEDEE;
    --latte:#9A5B2A; --latte-soft:#F1E3D3; --good:#2E7D4F; --warn:#B26A0B;
    --display:"Bricolage Grotesque","Helvetica Neue",Arial,sans-serif;
    --body:"Literata",Georgia,serif;
    --mono:"IBM Plex Mono",ui-monospace,Menlo,monospace;
  }
  @media (prefers-color-scheme: dark){
    :root{
      --ground:#161310; --surface:#1F1B17; --surface-2:#282320;
      --ink:#F0EAE1; --ink-2:#C9C1B6; --muted:#948B80; --line:#3A332D;
      --accent:#5FB3BB; --accent-ink:#0F1A1B; --accent-soft:#1D3235;
      --latte:#D2955B; --latte-soft:#3A2A1B; --good:#6CC08B; --warn:#E0A24B;
    }
  }
  *{box-sizing:border-box}
  html{color-scheme:light dark}
  body{margin:0;background:var(--ground);color:var(--ink);font-family:var(--body);font-size:17px;line-height:1.6;-webkit-font-smoothing:antialiased}
  a{color:var(--accent);text-underline-offset:3px;text-decoration-thickness:1px}
  a:focus-visible,button:focus-visible,select:focus-visible,input:focus-visible{outline:2px solid var(--accent);outline-offset:3px}
  .skip{position:absolute;left:-999px;top:8px;background:var(--accent);color:var(--accent-ink);padding:8px 12px;border-radius:4px}
  .skip:focus{left:8px}
  header.site{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:12px 24px;max-width:1080px;margin:0 auto;padding:20px 24px;border-bottom:1px solid var(--line)}
  .brand{font-family:var(--display);font-weight:700;font-size:22px;letter-spacing:-.02em;color:var(--ink);text-decoration:none}
  .brand span{color:var(--accent)}
  header.site nav{display:flex;flex-wrap:wrap;gap:6px 18px;font-family:var(--display);font-weight:500;font-size:15px}
  header.site nav a{color:var(--ink-2);text-decoration:none}
  header.site nav a:hover{color:var(--accent)}
  main{max-width:1080px;margin:0 auto;padding:36px 24px 72px}
  footer.site{max-width:1080px;margin:0 auto;padding:24px 24px 48px;border-top:1px solid var(--line);font-size:14px;color:var(--muted)}
  footer.site p{max-width:70ch;margin:0 0 8px}
  h1{font-family:var(--display);font-weight:700;font-size:clamp(30px,4.5vw,44px);line-height:1.05;letter-spacing:-.02em;margin:0 0 12px;text-wrap:balance}
  h2{font-family:var(--display);font-weight:700;font-size:24px;letter-spacing:-.015em;line-height:1.15;margin:32px 0 12px;text-wrap:balance}
  h3{font-family:var(--display);font-weight:600;font-size:18px;margin:0 0 6px}
  p{margin:0 0 14px;max-width:66ch}
  .lede{font-size:19px;color:var(--ink-2)}
  .eyebrow{font-family:var(--mono);font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);margin:0 0 10px}
  .tablewrap{overflow-x:auto;border:1px solid var(--line);border-radius:6px;background:var(--surface);margin:18px 0}
  table{border-collapse:collapse;width:100%;font-size:14.5px;font-variant-numeric:tabular-nums}
  th,td{padding:10px 12px;text-align:left;vertical-align:top;border-bottom:1px solid var(--line)}
  th{font-family:var(--mono);font-weight:500;font-size:11.5px;letter-spacing:.06em;text-transform:uppercase;color:var(--muted);background:var(--surface-2);white-space:nowrap}
  th[data-sort]{cursor:pointer;user-select:none}
  th[data-sort]:hover{color:var(--accent)}
  th[aria-sort="ascending"]::after{content:" ↑"}
  th[aria-sort="descending"]::after{content:" ↓"}
  tr:last-child td{border-bottom:none}
  td.num{font-family:var(--mono);font-size:13.5px;white-space:nowrap}
  td a{color:var(--ink);font-weight:600;text-decoration:none}
  td a:hover{color:var(--accent);text-decoration:underline}
  .pill{display:inline-block;font-family:var(--mono);font-size:11px;letter-spacing:.04em;padding:2px 8px;border-radius:999px;background:var(--accent-soft);color:var(--accent);white-space:nowrap}
  .pill.latte{background:var(--latte-soft);color:var(--latte)}
  .pill.unverified{background:transparent;border:1px solid var(--warn);color:var(--warn)}
  .card{background:var(--surface);border:1px solid var(--line);border-radius:6px;padding:16px 18px}
  .grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:14px;margin:18px 0}
  .stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(130px,1fr));gap:12px;margin:20px 0}
  .stat{background:var(--surface);border:1px solid var(--line);border-radius:6px;padding:14px 16px}
  .stat .n{font-family:var(--display);font-weight:700;font-size:26px;letter-spacing:-.02em;line-height:1;font-variant-numeric:tabular-nums}
  .stat .l{font-size:13px;color:var(--muted);margin-top:6px}
  .btn{display:inline-block;font-family:var(--display);font-weight:600;font-size:15px;background:var(--accent);color:var(--accent-ink);padding:10px 16px;border-radius:6px;text-decoration:none}
  .btn.secondary{background:var(--surface);color:var(--ink);border:1px solid var(--line)}
  .buy{display:flex;flex-wrap:wrap;gap:10px;margin:16px 0}
  .disclosure{font-size:13.5px;color:var(--muted);border-left:3px solid var(--line);padding:6px 12px;margin:16px 0}
  .meta{font-family:var(--mono);font-size:12.5px;color:var(--muted)}
  .filters{display:flex;flex-wrap:wrap;gap:10px;margin:18px 0 6px;align-items:center}
  .filters label{font-family:var(--display);font-weight:500;font-size:14px;color:var(--ink-2);display:flex;gap:6px;align-items:center}
  .filters select{font:inherit;font-size:14px;padding:6px 8px;border:1px solid var(--line);border-radius:6px;background:var(--surface);color:var(--ink)}
  @media (prefers-reduced-motion:no-preference){a{transition:color .15s}}
</style>
