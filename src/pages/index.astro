---
import Base from '../layouts/Base.astro';
import RankCard from '../components/RankCard.astro';
import Disclosure from '../components/Disclosure.astro';
import { allProducts, bestPages } from '../lib/products';

const products = await allProducts();
const byCaffeine = [...products].sort((a, b) => (b.data.caffeineMg ?? -1) - (a.data.caffeineMg ?? -1));
const brands = new Set(products.map((p) => p.data.brandSlug)).size;
const updated = products.map((p) => p.data.updated).sort().at(-1);
const newest = products.filter((p) => p.data.launched).sort((a, b) => b.data.launched!.localeCompare(a.data.launched!)).slice(0, 3);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Canned Latte',
  url: 'https://cannedlatte.com',
  description: 'Every latte in a can, ranked by caffeine, sugar, protein and price.',
};
---
<Base title="Canned Latte" description="Every canned latte ranked by caffeine, sugar, protein, milk type and price per can. La Colombe, Death Wish, NOBL, Wandering Bear and more. Pick your can." jsonLd={jsonLd}>
  <div class="center">
    <span class="status"><span class="dot"></span><b>{products.length} cans</b> · {brands} brands · updated {updated} · <a href="/new" style="color:var(--primary);font-weight:600">new →</a></span>
    <h1>Every latte in a can, <span class="hl">ranked.</span></h1>
    <p class="lede">Real label numbers, sorted the way you actually choose: most caffeine, least sugar, cheapest, most protein.</p>
  </div>

  <label class="search" for="q">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
    <input id="q" type="search" placeholder="Search a brand or can" autocomplete="off" />
  </label>

  <div class="tabs" role="tablist" aria-label="Sort">
    <button role="tab" aria-selected="true" data-sort="caf" data-label="mg">Most caffeine</button>
    <button role="tab" aria-selected="false" data-sort="sugar" data-label="g sugar">Least sugar</button>
    <button role="tab" aria-selected="false" data-sort="price" data-label="/can">Cheapest</button>
    <button role="tab" aria-selected="false" data-sort="protein" data-label="g protein">Most protein</button>
  </div>

  <div class="pills" role="group" aria-label="Filter">
    <button class="pill" aria-pressed="true" data-filter="latte">Lattes</button>
    <button class="pill" aria-pressed="false" data-filter="oat">Oat milk</button>
    <button class="pill" aria-pressed="false" data-filter="dairyfree">Dairy-free</button>
    <button class="pill" aria-pressed="false" data-filter="noadded">No added sugar</button>
    <button class="pill" aria-pressed="false" data-filter="all">Everything</button>
    <a class="pill" href="/table">Full table →</a>
  </div>

  <div class="feed" id="feed">
    {byCaffeine.map((p, i) => <RankCard product={p} rank={i + 1} />)}
  </div>
  <p class="meta center" id="empty" hidden>No cans match. Try another filter.</p>
  <Disclosure />

  <div class="row-link"><h2 style="margin:0">Newest cans</h2><a class="more" href="/new">See all →</a></div>
  <div class="feed">
    {newest.map((p, i) => <RankCard product={p} rank={i + 1} stat={p.data.launched} />)}
  </div>

  <h2>Rankings</h2>
  <div class="grid">
    {bestPages.map((b) => (
      <a class="card" href={`/best/${b.slug}`}>
        <h3>{b.title}</h3>
        <p style="margin:0">{b.intro.split('.')[0]}.</p>
      </a>
    ))}
  </div>

  <h2>How we get the numbers</h2>
  <p>Every spec starts from the brand's label, site, or press release and is date-stamped on the product page. Cans marked <span class="tag warn">unverified</span> haven't been checked against a physical label yet; we buy and photograph each one and update the record when we do. Caffeine varies batch to batch, so treat every figure as typical rather than exact.</p>
</Base>

<script>
  const feed = document.getElementById('feed')!;
  const cards = Array.from(feed.querySelectorAll<HTMLElement>('.rank'));
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('.tabs [data-sort]'));
  const pills = Array.from(document.querySelectorAll<HTMLButtonElement>('.pills [data-filter]'));
  const q = document.getElementById('q') as HTMLInputElement;
  const empty = document.getElementById('empty')!;
  let sort = 'caf', filter = 'latte';
  const fmtStat = (key: string, v: string) => {
    if (v === '') return '—';
    if (key === 'caf') return `${v} mg`;
    if (key === 'sugar') return `${v} g sugar`;
    if (key === 'protein') return `${v} g protein`;
    if (key === 'price') return `$${Number(v).toFixed(2)}/can`;
    return v;
  };
  const apply = () => {
    const term = q.value.trim().toLowerCase();
    const asc = sort === 'sugar' || sort === 'price';
    const visible = cards.filter((c) => {
      const d = c.dataset;
      const okF = filter === 'all' || (filter === 'latte' && d.type === 'latte') || (filter === 'oat' && d.milk === 'oat') || (filter === 'dairyfree' && d.dairyfree === '1') || (filter === 'noadded' && d.noadded === '1');
      const okQ = !term || (d.name ?? '').includes(term);
      return okF && okQ;
    });
    visible.sort((a, b) => {
      const va = a.dataset[sort] === '' ? null : Number(a.dataset[sort]);
      const vb = b.dataset[sort] === '' ? null : Number(b.dataset[sort]);
      if (va == null && vb == null) return 0;
      if (va == null) return 1;
      if (vb == null) return -1;
      return asc ? va - vb : vb - va;
    });
    cards.forEach((c) => { c.hidden = true; });
    visible.forEach((c, i) => {
      c.hidden = false;
      c.dataset.rank = String(i + 1);
      c.querySelector('.pos')!.textContent = `#${i + 1}`;
      c.querySelector('[data-stat]')!.textContent = fmtStat(sort, c.dataset[sort] ?? '');
      feed.appendChild(c);
    });
    empty.hidden = visible.length > 0;
  };
  tabs.forEach((t) => t.addEventListener('click', () => { sort = t.dataset.sort!; tabs.forEach((x) => x.setAttribute('aria-selected', String(x === t))); apply(); }));
  pills.forEach((p) => p.addEventListener('click', () => { filter = p.dataset.filter!; pills.forEach((x) => x.setAttribute('aria-pressed', String(x === p))); apply(); }));
  q.addEventListener('input', apply);
  apply();
</script>
