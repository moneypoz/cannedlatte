---
import Base from '../layouts/Base.astro';
import ProductTable from '../components/ProductTable.astro';
import Disclosure from '../components/Disclosure.astro';
import { allProducts, bestPages } from '../lib/products';

const products = await allProducts();
const lattes = products.filter((p) => p.data.type === 'latte');
const withCaf = lattes.filter((p) => p.data.caffeineMg != null);
const withSugar = lattes.filter((p) => p.data.sugarG != null);
const maxCaf = withCaf.reduce((m, p) => Math.max(m, p.data.caffeineMg!), 0);
const minSugar = withSugar.reduce((m, p) => Math.min(m, p.data.sugarG!), 999);
const brands = new Set(products.map((p) => p.data.brandSlug)).size;
const updated = products.map((p) => p.data.updated).sort().at(-1);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Canned Latte',
  url: 'https://cannedlatte.com',
  description: 'Every latte in a can, compared by caffeine, sugar, protein, milk and price.',
};
---
<Base title="Canned Latte" description="Every canned latte compared: caffeine, sugar, protein, milk type and price per can, from La Colombe to Death Wish to NOBL. Sort the table, pick your can." jsonLd={jsonLd}>
  <p class="eyebrow">Updated {updated} · {products.length} products · {brands} brands</p>
  <h1>Every latte in a can, compared.</h1>
  <p class="lede">Caffeine, sugar, protein, milk and price per can, in one sortable table. Click a column to sort. Click a product for the full label and where to buy it.</p>

  <div class="stats">
    <div class="stat"><div class="n">{lattes.length}</div><div class="l">canned lattes tracked</div></div>
    <div class="stat"><div class="n">{maxCaf} mg</div><div class="l">most caffeine in a can</div></div>
    <div class="stat"><div class="n">{minSugar} g</div><div class="l">least sugar in a can</div></div>
    <div class="stat"><div class="n">{products.filter((p) => p.data.dairyFree).length}</div><div class="l">dairy-free options</div></div>
  </div>

  <div class="filters">
    <label>Type
      <select id="f-type">
        <option value="">All</option>
        <option value="latte" selected>Lattes only</option>
        <option value="black">Black cold brew</option>
        <option value="nitro">Nitro</option>
        <option value="energy">Coffee energy drinks</option>
      </select>
    </label>
    <label>Milk
      <select id="f-milk">
        <option value="">Any</option>
        <option value="dairyfree">Dairy-free</option>
        <option value="oat">Oat</option>
        <option value="dairy">Dairy</option>
      </select>
    </label>
    <span class="meta" id="f-count"></span>
  </div>

  <ProductTable products={products} showType={true} />
  <Disclosure />

  <h2>Shortcuts</h2>
  <div class="grid">
    {bestPages.map((b) => (
      <a class="card" href={`/best/${b.slug}`} style="text-decoration:none;color:inherit">
        <h3>{b.title}</h3>
        <p style="font-size:14.5px;color:var(--ink-2);margin:0">{b.intro.split('.')[0]}.</p>
      </a>
    ))}
  </div>

  <h2>How we get the numbers</h2>
  <p>Every spec starts from the brand's own label, site, or press release and is date-stamped on the product page. Products marked <span class="pill unverified">unverified</span> haven't been checked against a physical can yet; we buy and photograph each one and update the record when we do. Caffeine in coffee varies batch to batch, so treat every figure as typical rather than exact.</p>
</Base>

<script>
  const type = document.getElementById('f-type') as HTMLSelectElement;
  const milk = document.getElementById('f-milk') as HTMLSelectElement;
  const count = document.getElementById('f-count')!;
  const rows = Array.from(document.querySelectorAll<HTMLTableRowElement>('#products tbody tr'));
  const apply = () => {
    let n = 0;
    rows.forEach((r) => {
      const okType = !type.value || r.dataset.type === type.value;
      const okMilk = !milk.value || (milk.value === 'dairyfree' ? r.dataset.dairyfree === '1' : milk.value === 'dairy' ? r.dataset.dairyfree === '0' : r.dataset.milk === milk.value);
      const show = okType && okMilk;
      r.hidden = !show;
      if (show) n++;
    });
    count.textContent = `${n} shown`;
  };
  type.addEventListener('change', apply);
  milk.addEventListener('change', apply);
  apply();
</script>
