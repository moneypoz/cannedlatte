---
import Base from '../layouts/Base.astro';
import ProductTable from '../components/ProductTable.astro';
import Disclosure from '../components/Disclosure.astro';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { allProducts, bestPages, comparePairs, fullName, lattesOnly, shortName, fmt } from '../lib/products';

const products = await allProducts();

// Top picks. Restricted to cans we have both verified and photographed, so the row
// never shows a placeholder or an unchecked number. Each pick must be distinct:
// if a category's winner is already taken, fall through to the next-best.
// Photos are optional throughout this page: a missing one renders no image element
// at all rather than a placeholder box.
const productImages = import.meta.glob<{ default: ImageMetadata }>('../assets/products/*.jpg', { eager: true });
const productImage = (image?: string) =>
  image ? productImages[`../assets/products/${image.split('/').pop()}`]?.default : undefined;

// Transparent front-can cutouts, used at card/thumbnail size. The full composite
// (front + label) stays on the product page and in the schema image URL.
const cardImages = import.meta.glob<{ default: ImageMetadata }>('../assets/products/cards/*.png', { eager: true });
const cardImage = (image?: string) => {
  if (!image) return undefined;
  const slug = image.split('/').pop()!.replace(/\.jpe?g$/i, '');
  return cardImages[`../assets/products/cards/${slug}-card.png`]?.default;
};
// Prefer the cutout at card size; fall back to the composite if no crop exists.
const displayImage = (image?: string) => cardImage(image) ?? productImage(image);

// Lattes only, matching every /best list and the tiles below. Without this the
// cheapest *can* (a milk coffee at $1.99) and the cheapest *latte* ($2.83) show up
// as two different answers in adjacent modules on the same page.
const lattes = lattesOnly(products);
const eligible = lattes.filter((p) => p.data.verified && p.data.image);
const PICK_SPECS = [
  { label: 'Strongest', key: 'caffeineMg', dir: -1, stat: (d: any) => fmt.mg(d.caffeineMg) },
  { label: 'Least sugar', key: 'sugarG', dir: 1, stat: (d: any) => `${fmt.g(d.sugarG)} sugar` },
  { label: 'Most protein', key: 'proteinG', dir: -1, stat: (d: any) => `${fmt.g(d.proteinG)} protein` },
  { label: 'Best value', key: 'pricePerCan', dir: 1, stat: (d: any) => `${fmt.usd(d.pricePerCan)}/can` },
] as const;

const taken = new Set<string>();
const picks = PICK_SPECS.map(({ label, key, dir, stat }) => {
  const winner = eligible
    .filter((p) => (p.data as any)[key] != null && !taken.has(p.id))
    .sort((a, b) => dir * ((a.data as any)[key] - (b.data as any)[key]))[0];
  if (!winner) return null;
  taken.add(winner.id);
  return { label, product: winner, stat: stat(winner.data) };
}).filter(Boolean) as { label: string; product: (typeof products)[number]; stat: string }[];
const brands = new Set(products.map((p) => p.data.brandSlug)).size;
const updated = products.map((p) => p.data.updated).sort().at(-1);
// Genuinely newest first. The cards carry no photos any more, so there is nothing
// to gain from floating photographed cans up — that would just hide newer cans.
const newest = products
  .filter((p) => p.data.launched)
  .sort((a, b) => b.data.launched!.localeCompare(a.data.launched!))
  .slice(0, 3);

// "Find your can" tiles: each /best list summarised by its own filter+sort, so the
// leader and count always match the page it links to.
const listTiles = bestPages.map((b) => {
  const list = products.filter((p) => b.filter(p.data)).sort((x, y) => b.sort(x.data, y.data));
  const leader = list[0];
  // Two lists rank by caffeine but display something else in their metric column:
  // dairy-free shows milk type ("leads at Oat"), no-added-sugar shows total sugar
  // (which reads as *added* sugar under that heading). Both should show caffeine,
  // the figure that actually explains why the leader leads.
  const RANKED_BY_CAFFEINE = new Set(['no-added-sugar', 'dairy-free']);
  const raw = leader && !RANKED_BY_CAFFEINE.has(b.slug) ? b.metric(leader.data) : null;
  const metric = raw && /^[$0-9]/.test(raw) ? raw : leader ? fmt.mg(leader.data.caffeineMg) : null;
  return { href: `/best/${b.slug}`, short: b.short, count: list.length, leader, metric };
});
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Canned Latte',
  url: 'https://cannedlatte.com',
  description: 'Every latte in a can, compared by caffeine, sugar, protein, milk and price.',
};
---
<Base title="Canned Latte" description="Every canned latte compared: caffeine, sugar, protein, milk and price per can. La Colombe, Starbucks, illy, Slate, Death Wish and more." jsonLd={jsonLd}>
  <div class="center">
    <span class="status"><span class="dot"></span><b>{products.length} cans</b> · {brands} brands · updated {fmt.mdy(updated)} · <a href="/new" style="color:var(--primary);font-weight:600">new →</a></span>
    <h1>Every canned latte, <span class="hl">compared.</span></h1>
    <p class="lede">Real label numbers in one table. Click a column to sort, tap a filter to narrow it down, click a can for the full label and where to buy.</p>
  </div>

  {picks.length > 0 && (
    <section class="picks">
      <h2 class="picks-h">Top picks from {lattes.length} lattes</h2>
      <div class="picks-grid">
        {picks.map((pick) => (
          <a class="pick" href={`/latte/${pick.product.id}`}>
            <span class="pick-media">
              <Image src={displayImage(pick.product.data.image)!} alt="" height={120} densities={[1, 2]} format="webp" loading="lazy" />
            </span>
            <span class="pick-label">{pick.label}</span>
            <span class="pick-name">{fullName(pick.product.data)}</span>
            <span class="pick-stat">{pick.stat}</span>
          </a>
        ))}
      </div>
    </section>
  )}

  <label class="search" for="q">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
    <input id="q" type="search" placeholder="Search a brand or can" autocomplete="off" />
  </label>

  <div class="pills" role="group" aria-label="Filter">
    <button class="pill" aria-pressed="true" data-filter="latte">Lattes</button>
    <button class="pill" aria-pressed="false" data-filter="oat">Oat milk</button>
    <button class="pill" aria-pressed="false" data-filter="dairyfree">Dairy-free</button>
    <button class="pill" aria-pressed="false" data-filter="hiprotein">High protein</button>
    <button class="pill" aria-pressed="false" data-filter="noadded">No added sugar</button>
    <button class="pill" aria-pressed="false" data-filter="all">Everything</button>
    <span class="meta" id="f-count" style="align-self:center;margin-left:auto;white-space:nowrap"></span>
  </div>

  <ProductTable products={products} showType={true} />
  <p class="meta center" id="empty" hidden>No cans match. Try another filter.</p>
  <Disclosure />

  <div class="row-link"><h2 style="margin:0">Newest cans</h2><a class="more" href="/new">See all →</a></div>
  <div class="grid">
    {newest.map((p) => (
      <a class="card" href={`/latte/${p.id}`}>
        {displayImage(p.data.image) && (
          <span class="ncard-media">
            <Image src={displayImage(p.data.image)!} alt="" height={90} densities={[1, 2]} format="webp" loading="lazy" />
          </span>
        )}
        <span class="tag">{fmt.ym(p.data.launched)}</span>
        <h3 style="margin-top:8px" title={fullName(p.data)}>{shortName(p.data)}</h3>
        <p style="margin:0">{fmt.mg(p.data.caffeineMg)} · {fmt.g(p.data.sugarG)} sugar · {fmt.usd(p.data.pricePerCan)}/can</p>
      </a>
    ))}
  </div>

  <h2>Find your can</h2>
  <div class="tiles">
    {listTiles.map((t) => (
      <a class="tile" href={t.href}>
        {t.leader && displayImage(t.leader.data.image) && (
          <span class="tile-media">
            <Image src={displayImage(t.leader.data.image)!} alt="" height={40} densities={[1, 2]} format="webp" loading="lazy" />
          </span>
        )}
        <span class="tile-body">
          <span class="tile-title">{t.short}</span>
          {t.leader && (
            <>
              <span class="tile-metric">{t.metric}</span>
              <span class="tile-leader" title={fullName(t.leader.data)}>{shortName(t.leader.data)}</span>
            </>
          )}
        </span>
      </a>
    ))}
    <a class="tile" href="/table">
      <span class="tile-title">Every can</span>
      <span class="tile-metric">{products.length}</span>
      <span class="tile-leader">cans</span>
    </a>
  </div>
  <p class="meta"><a href="/compare">Head to head →</a> two cans side by side, {comparePairs.length} matchups.</p>

  <h2>How we get the numbers</h2>
  <p>Every spec starts from the brand's label, site, or press release and is date-stamped on the product page. Cans marked with an asterisk in the table above haven't been checked against a physical label yet; their product pages carry a <span class="tag warn">specs unverified</span> tag as well. We buy and photograph each one and update the record when we do. Caffeine varies batch to batch, so treat every figure as typical rather than exact.</p>
</Base>

<script>
  const rows = Array.from(document.querySelectorAll<HTMLTableRowElement>('#products tbody tr'));
  const pills = Array.from(document.querySelectorAll<HTMLButtonElement>('.pills [data-filter]'));
  const q = document.getElementById('q') as HTMLInputElement;
  const count = document.getElementById('f-count')!;
  const empty = document.getElementById('empty')!;
  let filter = 'latte';
  const apply = () => {
    const term = q.value.trim().toLowerCase();
    let n = 0;
    rows.forEach((r) => {
      const d = r.dataset;
      const okF = filter === 'all' || (filter === 'latte' && d.type === 'latte') || (filter === 'oat' && d.milk === 'oat') || (filter === 'dairyfree' && d.dairyfree === '1') || (filter === 'hiprotein' && d.hiprotein === '1') || (filter === 'noadded' && d.noadded === '1');
      const okQ = !term || (d.name ?? '').includes(term);
      r.hidden = !(okF && okQ);
      if (!r.hidden) n++;
    });
    count.textContent = `${n} shown`;
    empty.hidden = n > 0;
  };
  pills.forEach((p) => p.addEventListener('click', () => { filter = p.dataset.filter!; pills.forEach((x) => x.setAttribute('aria-pressed', String(x === p))); apply(); }));
  q.addEventListener('input', apply);
  apply();
</script>

<style>
  .picks { margin: 0 0 18px; }
  .picks-h {
    font-family: var(--mono); font-size: 12px; font-weight: 600; letter-spacing: .02em;
    color: var(--muted-foreground); text-transform: none; margin: 0 0 10px;
  }
  .picks-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; }
  .pick {
    display: flex; flex-direction: column; gap: 4px;
    border: 1px solid var(--border); border-radius: var(--radius);
    background: var(--card); padding: 10px; text-decoration: none; color: inherit;
  }
  .pick:hover { border-color: var(--muted-foreground); }
  .pick-media {
    display: grid; place-items: center; height: 120px; margin-bottom: 4px;
    background: var(--muted); border-radius: 8px; overflow: hidden;
  }
  /* Cutouts are transparent, so a soft shadow keeps them from looking pasted on. */
  .pick-media :global(img) {
    max-height: 112px; width: auto; object-fit: contain; display: block;
    filter: drop-shadow(0 4px 10px rgb(0 0 0 / 0.12));
  }
  .pick-label {
    align-self: flex-start; font-size: 11px; font-weight: 700; letter-spacing: .02em;
    background: var(--muted); color: var(--muted-foreground);
    border-radius: 999px; padding: 3px 9px;
  }
  .pick-name { font-weight: 600; font-size: 14px; line-height: 1.25; }
  .pick-stat { font-family: var(--mono); font-size: 13px; color: var(--primary); font-weight: 600; }
  @media (max-width: 700px) { .picks-grid { grid-template-columns: repeat(2, 1fr); } }
  /* Find your can: typographic mini-scoreboard tiles, 4x2 on desktop. */
  .tiles { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; }
  .tile {
    display: flex; align-items: center; gap: 10px; min-width: 0;
    border: 1px solid var(--border); border-radius: var(--radius);
    background: var(--card); padding: 10px 12px; text-decoration: none; color: inherit;
  }
  .tile-body { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  /* Cutout sits on a soft tile; the shadow is on the image so it follows the can. */
  .tile-media {
    flex: 0 0 auto; width: 40px; height: 40px; border-radius: 8px;
    background: var(--muted); display: grid; place-items: center; overflow: hidden;
  }
  .tile-media :global(img) {
    max-height: 36px; width: auto; object-fit: contain; display: block;
    filter: drop-shadow(0 2px 5px rgb(0 0 0 / 0.12));
  }
  .ncard-media {
    display: grid; place-items: center; height: 90px; margin-bottom: 8px;
    background: var(--muted); border-radius: 8px; overflow: hidden;
  }
  .ncard-media :global(img) {
    max-height: 82px; width: auto; object-fit: contain; display: block;
    filter: drop-shadow(0 4px 10px rgb(0 0 0 / 0.12));
  }
  .tile:hover { border-color: var(--primary); }
  .tile-title { font-size: 12.5px; color: var(--muted-foreground); }
  .tile-metric {
    font-family: var(--mono); font-weight: 600; font-size: 20px; line-height: 1.15;
    letter-spacing: -.02em; font-variant-numeric: tabular-nums; color: var(--primary);
  }
  .tile-leader {
    font-size: 12px; color: var(--muted-foreground); line-height: 1.3;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 100%;
  }
  @media (max-width: 900px) { .tiles { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 520px) { .tiles { grid-template-columns: 1fr; } }
</style>
