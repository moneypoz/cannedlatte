---
import Base from '../layouts/Base.astro';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { allProducts, comparePairs, shortName, metricSpread, rankedDiffs } from '../lib/products';
import type { P } from '../lib/products';

const products = await allProducts();
const byId = new Map(products.map((p) => [p.id, p]));
const spread = metricSpread(products);

// Transparent front-can cutouts, the same set the homepage uses at card size.
const cardImages = import.meta.glob<{ default: ImageMetadata }>('../assets/products/cards/*.png', { eager: true });
const cutout = (image?: string) => {
  if (!image) return undefined;
  const slug = image.split('/').pop()!.replace(/\.jpe?g$/i, '');
  return cardImages[`../assets/products/cards/${slug}-card.png`]?.default;
};
// Stand-in when a can hasn't been photographed and cut out yet. Same 70px box as a
// real cutout, so a row of cards never jumps depending on what we happen to have.
const initials = (p: P) => {
  const words = p.brand.split(/\s+/).filter((w) => /^[A-Za-z]/.test(w));
  // Two letters either way: one per word for "Pop & Bottle", the first two
  // letters for a single-word brand, since a lone "N" reads as a typo.
  return (words.length > 1 ? words.slice(0, 2).map((w) => w[0]!).join('') : words[0]!.slice(0, 2)).toUpperCase();
};

// Metric labels are lowercase where they're defined; the card leads with them.
// The line ends on "gap" so there is never a trailing word to orphan on a wrap.
const cap = (s: string) => s[0]!.toUpperCase() + s.slice(1);

const pairs = comparePairs
  .filter(([a, b]) => byId.has(a) && byId.has(b))
  .map(([a, b]) => {
    const A = byId.get(a)!, B = byId.get(b)!;
    // Only metrics both cans publish survive rankedDiffs, so the widest gap is
    // always printable — no "— vs 140 mg" against a missing figure.
    const top = rankedDiffs(A.data, B.data, spread)[0];
    return { slug: `${a}-vs-${b}`, a: A, b: B, top };
  });

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Canned Latte', item: 'https://cannedlatte.com/' },
    { '@type': 'ListItem', position: 2, name: 'Compare' },
  ],
};
---
<Base title="Compare canned lattes" description={`Head-to-head canned latte comparisons: caffeine, sugar, protein, milk and price side by side across ${pairs.length} matchups.`} jsonLd={jsonLd}>
  <p class="eyebrow"><a href="/">Canned Latte</a> · Compare</p>
  <h1>Head to head</h1>
  <p class="lede">Two cans, the same spec sheet, side by side. Useful when you've narrowed it to a shortlist and want the numbers next to each other rather than a page apart.</p>

  <div class="matchups">
    {pairs.map(({ slug, a, b, top }) => (
      <a class="card matchup" href={`/compare/${slug}`}>
        <div class="faceoff">
          {[a, b].map((p, i) => (
            <div class="can" style={i === 1 ? 'grid-column:3' : undefined}>
              {cutout(p.data.image)
                ? <Image src={cutout(p.data.image)!} alt="" height={70} densities={[1, 2]} format="webp" loading="lazy" />
                : <span class="initials">{initials(p.data)}</span>}
            </div>
          ))}
          <span class="vs-pill">VS</span>
          {[a, b].map((p, i) => <span class="name" style={i === 1 ? 'grid-column:3' : undefined}>{shortName(p.data)}</span>)}
        </div>
        <p class="meta gap">{top ? `${cap(top.label)}: ${top.display} gap` : 'Awaiting label data'}</p>
      </a>
    ))}
  </div>

  <h2>Want a matchup that isn't here?</h2>
  <p>Every can has its own page with the full label, and the <a href="/table">full table</a> sorts on any column. If there's a pairing you'd like written up, <a href="/contact">tell us</a>.</p>
</Base>

<style>
  .matchups { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; align-items: stretch; margin: 14px 0; }
  @media (max-width: 800px) { .matchups { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 520px) { .matchups { grid-template-columns: 1fr; } }

  .matchup { display: flex; flex-direction: column; gap: 12px; }

  /* Two 1fr columns for the cans and their names, with the VS pill in an auto
     column between them. Row 1 is the cans, row 2 the names. */
  .faceoff { display: grid; grid-template-columns: 1fr auto 1fr; column-gap: 8px; row-gap: 10px; }
  .can { grid-row: 1; display: flex; align-items: flex-end; justify-content: center; height: 70px; }
  .can img { height: 70px; width: auto; max-width: 100%; object-fit: contain; }
  .initials {
    width: 70px; height: 70px; border-radius: 50%; background: var(--muted); color: var(--muted-foreground);
    display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 19px; letter-spacing: .5px;
  }
  .vs-pill {
    grid-row: 1; grid-column: 2; align-self: center;
    background: var(--primary); color: var(--primary-foreground); border-radius: 999px;
    font-size: 11px; font-weight: 700; letter-spacing: .06em; padding: 3px 9px; line-height: 1.4;
  }
  /* Two lines then ellipsis: at 375px each name column is ~130px, so a long one
     must clip rather than push the card wider. */
  .name {
    grid-row: 2; text-align: center; font-size: 14px; font-weight: 600; line-height: 1.3;
    display: -webkit-box; -webkit-line-clamp: 2; line-clamp: 2; -webkit-box-orient: vertical;
    overflow: hidden; overflow-wrap: anywhere;
  }
  .gap { margin: auto 0 0; text-align: center; }
</style>
