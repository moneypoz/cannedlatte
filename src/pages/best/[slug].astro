---
import Base from '../../layouts/Base.astro';
import RankCard from '../../components/RankCard.astro';
import Disclosure from '../../components/Disclosure.astro';
import { allProducts, bestPages, fullName } from '../../lib/products';

export async function getStaticPaths() {
  const products = await allProducts();
  return bestPages.map((b) => ({ params: { slug: b.slug }, props: { page: b, products } }));
}
const { page, products } = Astro.props;
const list = products.filter((p) => page.filter(p.data)).sort((a, b) => page.sort(a.data, b.data));
const updated = list.map((p) => p.data.updated).sort().at(-1);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: page.title,
  itemListElement: list.map((p, i) => ({ '@type': 'ListItem', position: i + 1, name: fullName(p.data), url: `https://cannedlatte.com/latte/${p.id}` })),
};
---
<Base title={page.title} description={`${page.title}, ranked from real label data. ${page.intro}`} jsonLd={jsonLd}>
  <div class="center">
    <span class="status"><span class="dot"></span><b>{list.length} cans</b> · ranked from the database · updated {updated}</span>
    <h1>{page.title}</h1>
    <p class="lede">{page.intro}</p>
  </div>
  <div class="tabs" aria-label="Rankings">
    {bestPages.map((b) => <a href={`/best/${b.slug}`} class:list={[b.slug === page.slug && 'active']}>{b.short}</a>)}
  </div>
  <div class="feed">
    {list.map((p, i) => <RankCard product={p} rank={i + 1} stat={page.metric(p.data)} />)}
  </div>
  <Disclosure />
</Base>
