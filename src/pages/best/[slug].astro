---
import Base from '../../layouts/Base.astro';
import Disclosure from '../../components/Disclosure.astro';
import { allProducts, bestPages, fullName, fmt, milkLabel, bestHeadline, caffeineFigure } from '../../lib/products';
import { listContent } from '../../lib/listContent';

export async function getStaticPaths() {
  const products = await allProducts();
  return bestPages.map((b) => ({ params: { slug: b.slug }, props: { page: b, products } }));
}
const { page, products } = Astro.props;
const list = products.filter((p) => page.filter(p.data)).sort((a, b) => page.sort(a.data, b.data));
const updated = list.map((p) => p.data.updated).sort().at(-1);
const content = listContent[page.slug];
const jsonLd: Record<string, unknown>[] = [{
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: page.title,
  itemListElement: list.map((p, i) => ({ '@type': 'ListItem', position: i + 1, name: fullName(p.data), url: `https://cannedlatte.com/latte/${p.id}` })),
}];
if (content?.faqs.length) {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: content.faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  });
}
// The headline stat this ranking is allowed to crown. A /best title is a
// superlative resting on one record's figure, and two things can bar it:
//
//   'unverified' — Gate 1. The leader is brand-sourced, so the title falls back to
//     the count of the list, a fact about our own database that can be neither
//     unverified nor in conflict with the table below it. Reverses itself the day
//     that record is checked against a label.
//   'qualified' — the leader publishes a range or a ceiling, not a figure. A
//     superlative strips the qualifier off, so there is no honest automatic title
//     here at all: the page falls back to the count and check-claims.mjs stops the
//     build, because which number to crown is a decision for a person.
const headline = page.headline
  ? bestHeadline(list.map((p) => p.data), page.headline.field, page.headline.lowerWins)
  : null;
const crown = headline?.kind === 'crown' ? headline : null;
const seoTitle = crown ? page.headline!.crown(crown.value) : page.countTitle(list.length);
// page.metric is the same formatter the table cell uses, so the description states
// the leader exactly as the page renders it.
const crownStat = crown ? page.metric(crown.holder) : null;

// Keyword-bearing opener first, then as much of the intro as fits under 155 — added
// a sentence at a time, so a longer intro can never push the description into being
// truncated mid-phrase on a results page.
let description = crownStat
  ? `${page.title}, from real label data: ${list.length} cans ranked, ${page.headline!.lowerWins ? 'from' : 'up to'} ${crownStat}.`
  : `${page.title}, from real label data: ${list.length} cans ranked.`;
for (const sentence of page.intro.match(/[^.]+\./g) ?? []) {
  const next = `${description} ${sentence.trim()}`;
  if (next.length > 155) break;
  description = next;
}
---
<Base title={seoTitle} description={description} jsonLd={jsonLd} ogType="article">
  <div class="center">
    <span class="status"><span class="dot"></span><b>{list.length} cans</b> · from the database · updated {fmt.mdy(updated)}</span>
    <h1>{page.title}</h1>
    <p class="lede">{page.intro}</p>
  </div>
  <div class="pills" role="group" aria-label="Lists" style="justify-content:center">
    {bestPages.map((b) => <a href={`/best/${b.slug}`} class:list={['pill', b.slug === page.slug && 'on']}>{b.short}</a>)}
  </div>
  <div class="tablewrap">
    <table>
      <thead><tr><th>Product</th><th>{page.metricLabel}</th><th>Caffeine</th><th>Sugar</th><th>Protein</th><th>Milk</th><th>Per can</th></tr></thead>
      <tbody>
        {list.map((p) => (
          <tr>
            <td><a href={`/latte/${p.id}`}>{fullName(p.data)}</a>{!p.data.verified && <> <span class="tag warn">unverified</span></>}</td>
            <td class="num"><strong style="color:var(--primary)">{page.metric(p.data)}</strong></td>
            <td class="num">{caffeineFigure(p.data)}</td>
            <td class="num">{fmt.g(p.data.sugarG)}</td>
            <td class="num">{fmt.g(p.data.proteinG)}</td>
            <td>{milkLabel[p.data.milk]}</td>
            <td class="num">{fmt.usd(p.data.pricePerCan)}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <Disclosure />
  {content && (
    <div style="max-width:62ch;margin:8px auto 0">
      <h2>About this list</h2>
      {content.paragraphs.map((para) => <p>{para}</p>)}
      <h2>Questions</h2>
      {content.faqs.map((f) => (<><h3>{f.q}</h3><p>{f.a}</p></>))}
    </div>
  )}
</Base>
