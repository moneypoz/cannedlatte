---
import Base from '../../layouts/Base.astro';
import { allProducts, fullName, fmt } from '../../lib/products';

// One-question pages: "how much caffeine in X". Only built for products with a known figure.
export async function getStaticPaths() {
  const products = await allProducts();
  const known = products.filter((p) => p.data.caffeineMg != null);
  return known.map((p) => ({ params: { slug: p.id }, props: { product: p, all: known } }));
}
const { product, all } = Astro.props;
const p = product.data;
const name = fullName(p);
const perOz = p.sizeOz ? (p.caffeineMg! / p.sizeOz).toFixed(1) : null;
const rank = [...all].sort((x, y) => y.data.caffeineMg! - x.data.caffeineMg!).findIndex((x) => x.id === product.id) + 1;
const jsonLd = {
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: [{ '@type': 'Question', name: `How much caffeine is in ${name}?`, acceptedAnswer: { '@type': 'Answer', text: `${name} contains about ${p.caffeineMg} mg of caffeine per can.` } }],
};
---
<Base title={`How much caffeine is in ${name}?`} description={`${name} has about ${p.caffeineMg} mg of caffeine per can${perOz ? ` (${perOz} mg per oz)` : ''}. How it compares to drip coffee and other canned lattes.`} jsonLd={jsonLd}>
  <p class="eyebrow">Caffeine</p>
  <h1>How much caffeine is in {name}?</h1>
  <p class="lede"><strong>{p.caffeineMg} mg per can.</strong>{perOz && ` That's ${perOz} mg per ounce.`}{p.caffeineNote && ` ${p.caffeineNote}.`}</p>
  <div class="stats">
    <div class="stat-card"><div class="n">{p.caffeineMg} mg</div><div class="l">per can</div></div>
    {perOz && <div class="stat-card"><div class="n">{perOz}</div><div class="l">mg per oz</div></div>}
    <div class="stat-card"><div class="n">#{rank}</div><div class="l">of {all.length} tracked, most caffeine first</div></div>
  </div>
  <h2>For comparison</h2>
  <p>A 12 oz drip coffee is typically 140–200 mg. A single espresso shot is around 65–75 mg. The FDA's guideline for healthy adults is up to 400 mg a day, so {name} is roughly {Math.round((p.caffeineMg! / 400) * 100)}% of that in one can.</p>
  <p><a class="btn" href={`/latte/${product.id}`}>Full specs and where to buy</a> <a class="btn secondary" href="/best/most-caffeine">All lattes by caffeine</a></p>
</Base>
