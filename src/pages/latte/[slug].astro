---
import Base from '../../layouts/Base.astro';
import BuyLinks from '../../components/BuyLinks.astro';
import Disclosure from '../../components/Disclosure.astro';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { allProducts, caffeineGuideFor, comparisonsFor, fmt, milkLabel, typeLabel, fullName, productTitle, caffeineFigure, REVIEWER } from '../../lib/products';
import { editionsFor } from '../../lib/editions';

// Originals stay in public/ (used for the absolute JSON-LD URL); these copies under
// src/assets/ are what Astro processes into resized WebP at build time.
const productImages = import.meta.glob<{ default: ImageMetadata }>('../../assets/products/*.jpg', { eager: true });

export async function getStaticPaths() {
  const products = await allProducts();
  return products.map((p) => ({ params: { slug: p.id }, props: { product: p, all: products } }));
}
const { product, all } = Astro.props;
const p = product.data;
const heroImage = p.image
  ? productImages[`../../assets/products/${p.image.split('/').pop()}`]?.default
  : undefined;
// Our own can on the day it was drunk, shown with the tasting notes. Separate from
// the hero on purpose: the hero is the clean catalogue shot every layout is built
// around, and this one is evidence that a person bought the can and drank it.
const tastingImage = p.tastingPhoto
  ? productImages[`../../assets/products/${p.tastingPhoto.split('/').pop()}`]?.default
  : undefined;
const name = fullName(p);
// A rating and its notes render together or not at all. The visible section and the
// Product schema are gated on this one expression, so the markup can never claim a
// review the page does not show, and an unrated can renders nothing at all — no
// empty stars, no "not yet rated". The schema also refuses either field without the
// other, so this is a second lock on the same door rather than the only one.
const rated = p.rating != null && !!p.tastingNotes?.trim();
// Alternate artwork for this same can — same panel, same UPC, no record of its own.
const editions = editionsFor(product.id)
  .map((e) => ({ ...e, src: productImages[`../../assets/products/${e.image}`]?.default }))
  .filter((e) => e.src);
const comparisons = comparisonsFor(product.id)
  .map((c) => ({ ...c, other: all.find((x) => x.id === c.otherId) }))
  .filter((c) => c.other);
const siblings = all.filter((x) => x.data.brandSlug === p.brandSlug && x.id !== product.id);
// Brand-level caffeine guide, where this brand has one.
const guide = caffeineGuideFor(p.brandSlug);
const similar = all
  .filter((x) => x.id !== product.id && x.data.type === p.type && x.data.milk === p.milk)
  .slice(0, 4);

const descCore = [
  `${name}: ${p.caffeineMg != null ? `${caffeineFigure(p)} caffeine` : 'caffeine TBD'}`,
  p.sugarG != null ? `${p.sugarG} g sugar` : null,
  p.proteinG != null ? `${p.proteinG} g protein` : null,
  `${milkLabel[p.milk].toLowerCase()} milk`,
  p.pricePerCan != null ? `about ${fmt.usd(p.pricePerCan)} per can` : null,
].filter(Boolean).join(', ') + '.';
// Specs first, invitation second: the tail is dropped rather than letting the
// description run past 155 and get truncated mid-phrase in the results page.
const descTail = ' Full specs and where to buy.';
const desc = descCore.length + descTail.length <= 155 ? descCore + descTail : descCore;

const faqs = [
  p.caffeineMg != null && { q: `How much caffeine is in ${name}?`, a: `${name} has ${p.caffeineBasis === 'exact' ? 'about ' : ''}${caffeineFigure(p)} of caffeine per ${p.sizeOz ? `${p.sizeOz} oz ` : ''}can${p.caffeineNote ? ` (${p.caffeineNote.toLowerCase()})` : ''}. A 12 oz drip coffee is typically 140–200 mg.` },
  p.sugarG != null && { q: `How much sugar is in ${name}?`, a: `${p.sugarG} g of sugar per can${p.addedSugar === false ? ', with no added sugar' : p.addedSugar ? ', including added sugar' : ''}.` },
  { q: `Is ${name} dairy-free?`, a: p.dairyFree ? `Yes. It's made with ${milkLabel[p.milk].toLowerCase()} milk.` : `No. It's made with ${milkLabel[p.milk].toLowerCase()} milk.` },
  p.refrigerated && { q: `Does ${name} need to be refrigerated?`, a: `Yes. It has no shelf-stable processing and ships cold.` },
].filter(Boolean) as { q: string; a: string }[];

const jsonLd = [
  rated && {
    '@context': 'https://schema.org',
    '@type': 'Product',
    name,
    brand: { '@type': 'Brand', name: p.brand },
    description: p.summary,
    ...(p.image ? { image: `https://cannedlatte.com${p.image}` } : {}),
    // No offers: we compare, we don't sell.
    additionalProperty: [
      p.caffeineMg != null && { '@type': 'PropertyValue', name: 'Caffeine', value: p.caffeineMg, unitText: 'mg' },
      p.sugarG != null && { '@type': 'PropertyValue', name: 'Sugar', value: p.sugarG, unitText: 'g' },
      p.proteinG != null && { '@type': 'PropertyValue', name: 'Protein', value: p.proteinG, unitText: 'g' },
      p.pricePerCan != null && { '@type': 'PropertyValue', name: 'Typical price per can', value: p.pricePerCan.toFixed(2), unitText: 'USD' },
    ].filter(Boolean),
    review: {
      '@type': 'Review',
      reviewRating: { '@type': 'Rating', ratingValue: p.rating, bestRating: 5 },
      // A person, not the site: one human drank this can and wrote the notes, and the
      // visible byline under the rating names the same person this does.
      author: { '@type': 'Person', name: REVIEWER.name, url: REVIEWER.url },
      ...(p.tastedOn ? { datePublished: p.tastedOn } : {}),
      reviewBody: p.tastingNotes,
    },
  },
  faqs.length && {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
].filter(Boolean) as Record<string, unknown>[];
jsonLd.push({
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Canned Latte', item: 'https://cannedlatte.com/' },
    { '@type': 'ListItem', position: 2, name: p.brand, item: `https://cannedlatte.com/brands/${p.brandSlug}` },
    { '@type': 'ListItem', position: 3, name: p.name },
  ],
});
---
<Base title={productTitle(p)} description={desc} jsonLd={jsonLd} ogType="article"
      image={p.image} imageAlt={p.image ? `${name} can` : undefined}>
  <div class="product-top">
    <div class="product-info">
      <p class="eyebrow"><a href={`/brands/${p.brandSlug}`}>{p.brand}</a> · <span class="tag">{typeLabel[p.type]}</span>{!p.verified && <> <span class="tag warn">specs unverified</span></>}</p>
      <h1>{name}</h1>
      <p class="lede">{p.summary}</p>

      {editions.map((e) => (
        <figure class="edition">
          <Image src={e.src!} alt={`${name} — ${e.caption}`} width={200} densities={[1, 2]} format="webp" loading="lazy" />
          <figcaption>{e.caption}</figcaption>
        </figure>
      ))}

      <div class="stats">
        <div class="stat-card"><div class="n">{caffeineFigure(p)}</div><div class="l">caffeine</div></div>
        <div class="stat-card"><div class="n">{fmt.g(p.sugarG)}</div><div class="l">sugar{p.addedSugarG != null && p.addedSugarG > 0 ? ` (${p.addedSugarG}g added)` : p.addedSugar === false ? " (none added)" : ""}</div></div>
        <div class="stat-card"><div class="n">{fmt.g(p.proteinG)}</div><div class="l">protein</div></div>
        <div class="stat-card"><div class="n">{fmt.oz(p.sizeOz)}</div><div class="l">can size</div></div>
        <div class="stat-card"><div class="n">{fmt.usd(p.pricePerCan)}</div><div class="l">per can{p.packPrice ? ` (${fmt.usd(p.packPrice)} / ${p.packSize})` : ''}</div></div>
      </div>

      <BuyLinks product={p} />
      <Disclosure />
    </div>

    {heroImage && <Image class="hero" src={heroImage} alt={`${name} can`} width={480} densities={[1, 2]} format="webp" loading="eager" />}
  </div>

  <div class="tablewrap">
    <table>
      <tbody>
        <tr><th>Milk</th><td>{milkLabel[p.milk]}{p.dairyFree ? ' · dairy-free' : ''}</td></tr>
        {p.flavor && <tr><th>Flavor</th><td>{p.flavor}</td></tr>}
        {p.caffeineNote && <tr><th>Caffeine note</th><td>{p.caffeineNote}</td></tr>}
        {p.calories != null && <tr><th>Calories</th><td>{p.calories}</td></tr>}
        {p.upc && <tr><th>UPC</th><td class="mono">{p.upc}</td></tr>}
        <tr><th>Storage</th><td>{p.refrigerated ? 'Refrigerated' : 'Shelf-stable'}</td></tr>
        {p.launched && <tr><th>Launched</th><td>{fmt.ym(p.launched)}</td></tr>}
        <tr><th>Specs updated</th><td>{fmt.mdy(p.updated)}{p.verified ? ' · checked against a label' : ' · from brand site / press'}</td></tr>
      </tbody>
    </table>
  </div>

  {rated && (
    <>
      <h2>Tasting notes</h2>
      {(p.rating != null || p.tastedOn) && (
        <p class="meta">
          {p.rating != null && (
            <>
              <span class="stars" aria-hidden="true">
                ★★★★★<span style={`width:${Math.round((p.rating / 5) * 1000) / 10}%`}>★★★★★</span>
              </span>{' '}
              <b>My rating: {p.rating}/5</b>
            </>
          )}
          {p.rating != null && p.tastedOn ? ' · ' : ''}
          {p.tastedOn && <>Tasted {fmt.mdy(p.tastedOn)}</>}
          {' · '}<a href="/about">by {REVIEWER.name}</a>
        </p>
      )}
      {tastingImage && (
        <figure class="tasting">
          <Image src={tastingImage} alt={`My can of ${name}, photographed the day I drank it`} width={280} densities={[1, 2]} format="webp" loading="lazy" />
          <figcaption>My can, photographed the day I drank it.</figcaption>
        </figure>
      )}
      <p>{p.tastingNotes}</p>
      {/* Wherever a score renders, so does this. The rankings sort on sugar,
          caffeine, protein and price and have no access to `rating` at all — but a
          reader cannot see that from here, and a site that scores things owes them
          the sentence rather than the benefit of the doubt. */}
      {p.rating != null && (
        <p class="meta" data-claims="rating-disclosure">
          Ratings are my personal taste and don't affect the data rankings.
        </p>
      )}
    </>
  )}

  {faqs.length > 0 && (
    <>
      <h2>Questions</h2>
      {faqs.map((f) => (<><h3>{f.q}</h3><p>{f.a}</p></>))}
    </>
  )}

  {comparisons.length > 0 && (
    <>
      <h2>Head to head</h2>
      <ul>{comparisons.map((c) => (
        <li><a href={`/compare/${c.slug}`}>{name} vs {fullName(c.other!.data)}</a></li>
      ))}</ul>
      <p class="meta"><a href="/compare">All comparisons →</a></p>
    </>
  )}

  {(siblings.length > 0 || guide) && (
    <>
      <h2>More from {p.brand}</h2>
      {siblings.length > 0 && <ul>{siblings.map((s) => <li><a href={`/latte/${s.id}`}>{s.data.name}</a></li>)}</ul>}
      {guide && <p><a href={`/caffeine/${guide.slug}`}>{guide.linkText}</a> — the whole lineup in one table, by milligrams per can and per ounce.</p>}
    </>
  )}
  {similar.length > 0 && (
    <>
      <h2>Similar cans</h2>
      <ul>{similar.map((s) => <li><a href={`/latte/${s.id}`}>{fullName(s.data)}</a> — {caffeineFigure(s.data)}, {fmt.g(s.data.sugarG)} sugar</li>)}</ul>
    </>
  )}

  {p.sources.length > 0 && (
    <p class="meta">Sources: {p.sources.map((s, i) => <><a href={s} rel="noopener">[{i + 1}]</a> </>)}</p>
  )}
</Base>
