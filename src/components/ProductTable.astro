---
import type { Product } from '../lib/products';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { fmt, milkLabel, typeLabel } from '../lib/products';
interface Props { products: Product[]; sortable?: boolean; showType?: boolean; }
const { products, sortable = true, showType = false } = Astro.props;

// Same pattern as the product pages: originals live in public/, these copies are
// what Astro processes into resized WebP thumbnails at build time.
const productImages = import.meta.glob<{ default: ImageMetadata }>('../assets/products/*.jpg', { eager: true });
const thumbFor = (image?: string) =>
  image ? productImages[`../assets/products/${image.split('/').pop()}`]?.default : undefined;

const anyUnverified = products.some((p) => !p.data.verified);
---
<div class="tablewrap">
<table id="products" data-sortable={sortable ? 'true' : undefined}>
  <thead>
    <tr>
      <th data-sort="text">Product</th>
      {showType && <th data-sort="text">Type</th>}
      <th data-sort="num">Size</th>
      <th data-sort="num">Caffeine</th>
      <th data-sort="num">Sugar</th>
      <th data-sort="num">Protein</th>
      <th data-sort="text">Milk</th>
      <th data-sort="num">Per can</th>
    </tr>
  </thead>
  <tbody>
    {products.map(({ id, data: p }) => (
      <tr data-type={p.type} data-milk={p.milk} data-dairyfree={p.dairyFree ? '1' : '0'} data-noadded={p.addedSugar === false ? '1' : '0'} data-hiprotein={(p.proteinG ?? 0) >= 10 ? '1' : '0'} data-name={`${p.brand} ${p.name}`.toLowerCase()}>
        <td>
          <div class="prodcell">
            <a class="prodlink" href={`/latte/${id}`}>
              {thumbFor(p.image)
                ? <Image class="thumb" src={thumbFor(p.image)!} alt="" width={44} height={44} densities={[1, 2]} format="webp" loading="lazy" />
                : <span class="thumb thumb-ph" aria-hidden="true">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                      <rect x="7" y="3" width="10" height="18" rx="2.5" />
                      <path d="M7 7.5h10" />
                    </svg>
                  </span>}
              <span class="pname">{p.brand} {p.name}</span>
            </a>
            {!p.verified && <sup class="unv" title="Specs not yet checked against a label">*</sup>}
          </div>
        </td>
        {showType && <td><span class="tag">{typeLabel[p.type]}</span></td>}
        <td class="num" data-v={p.sizeOz ?? ''}>{fmt.oz(p.sizeOz)}</td>
        <td class="num" data-v={p.caffeineMg ?? ''}>{fmt.mg(p.caffeineMg)}</td>
        <td class="num" data-v={p.sugarG ?? ''}>{fmt.g(p.sugarG)}</td>
        <td class="num" data-v={p.proteinG ?? ''}>{fmt.g(p.proteinG)}</td>
        <td>{milkLabel[p.milk]}</td>
        <td class="num" data-v={p.pricePerCan ?? ''}>{fmt.usd(p.pricePerCan)}</td>
      </tr>
    ))}
  </tbody>
</table>
</div>
{anyUnverified && <p class="tablenote">* specs from the brand's site, not yet checked against a label.</p>}

<style>
  /* Tighter vertical padding so a 44px thumbnail still leaves rows ~56px tall. */
  td { padding-top: 6px; padding-bottom: 6px; vertical-align: middle; }
  .prodcell { display: flex; align-items: center; gap: 6px; }
  .prodlink { display: flex; align-items: center; gap: 10px; text-decoration: none; color: inherit; min-width: 0; }
  .prodlink:hover .pname { text-decoration: underline; }
  .pname { min-width: 0; }
  .thumb {
    flex: 0 0 auto; width: 44px; height: 44px; border-radius: 8px;
    background: var(--muted); object-fit: contain; display: block;
  }
  /* Placeholder keeps the exact same box, so nothing shifts. */
  .thumb-ph {
    display: grid; place-items: center;
    color: var(--muted-foreground); opacity: .55;
  }
  .unv { color: var(--muted-foreground); font-size: 11px; cursor: help; line-height: 1; }
  .tablenote { margin: -8px 0 16px; font-size: 12.5px; color: var(--muted-foreground); }
</style>

<script>
  // Click-to-sort. Empty cells (unverified specs) always sink to the bottom.
  document.querySelectorAll<HTMLTableElement>('table[data-sortable]').forEach((table) => {
    const ths = table.querySelectorAll<HTMLTableCellElement>('th[data-sort]');
    ths.forEach((th, idx) => {
      th.tabIndex = 0;
      const run = () => {
        const dir = th.getAttribute('aria-sort') === 'ascending' ? 'descending' : 'ascending';
        ths.forEach((t) => t.removeAttribute('aria-sort'));
        th.setAttribute('aria-sort', dir);
        const kind = th.dataset.sort;
        const rows = Array.from(table.tBodies[0].rows);
        rows.sort((a, b) => {
          const ca = a.cells[idx], cb = b.cells[idx];
          if (kind === 'num') {
            const va = ca.dataset.v === '' ? null : Number(ca.dataset.v);
            const vb = cb.dataset.v === '' ? null : Number(cb.dataset.v);
            if (va == null && vb == null) return 0;
            if (va == null) return 1;
            if (vb == null) return -1;
            return dir === 'ascending' ? va - vb : vb - va;
          }
          const r = ca.textContent!.trim().localeCompare(cb.textContent!.trim());
          return dir === 'ascending' ? r : -r;
        });
        rows.forEach((r) => table.tBodies[0].appendChild(r));
      };
      th.addEventListener('click', run);
      th.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); run(); } });
    });
  });
</script>
